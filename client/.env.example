# Client build-time config (Vite). Copy to client/.env for local overrides.

# Base URL of the API + Socket.IO server.
#   - Leave EMPTY for local dev — the Vite dev proxy forwards /api and /socket.io to :4000
#   - On Vercel, set this to the deployed server URL, e.g.
#     VITE_API_URL=https://invite-xxxx.onrender.com
VITE_API_URL=
