generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visit {
  id        String   @id @default(cuid())
  visitorId String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model Response {
  id         String   @id @default(cuid())
  answer     String // "yes" | "no"
  message    String?
  chosenSlot String?
  dodgeCount Int      @default(0)
  visitorId  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([visitorId])
  @@index([createdAt])
  @@index([updatedAt])
}
