# --- Database ---
# Local (docker-compose.yml):
DATABASE_URL="postgresql://invite:invite_dev_pw@localhost:5432/invite_db?schema=public"
#
# Hosted (Render PostgreSQL) — use the *External* URL locally, add ?sslmode=require:
# DATABASE_URL="postgresql://invite:PASSWORD@dpg-xxxxx.singapore-postgres.render.com/invite?sslmode=require"
# On the Render web service itself, set DATABASE_URL to the *Internal* URL instead.

# --- Server ---
PORT=4000
# Allowed browser origin(s) for CORS + Socket.IO. One value, or comma-separated.
# Split deploy: set to your Vercel client URL, e.g.
#   CLIENT_ORIGIN="https://huurhun-husleed.vercel.app"
CLIENT_ORIGIN="http://localhost:5174"

# Admin role key. RBAC: "public" role opens the invitation, "admin" role (this key)
# opens the dashboard: /dashboard?key=YOUR_KEY once, then it is remembered.
# Use a long random string in production — anyone with this key can read responses.
ADMIN_KEY="change-me-to-a-long-random-string"

# --- Invitation content (edit these to personalise the page) ---
INVITE_TO="Энхжин"
INVITE_FROM="Myngaa"
INVITE_KICKER="Мянгаагаас чамд тавих нэг санал байна 💌"
INVITE_QUESTION="Энхжин, надтай болзоонд явах уу?"
INVITE_MESSAGE="Зүгээр л биеэ бэлдээд хүрээд ир. Юу хийх, хаашаа явах гээд юунд ч санаа зовох хэрэггүй. Миний хажууд тухтай суугаад, тайван амьсгалаад, өөрийнхөөрөө байхад л болно. Чи ирэхэд л тэр өдөр онцгой болно. Бусдыг нь бүгдийг нь надад даатга. 💛"

# Event cards offered as the choice (JSON array). Optional "imageUrl" adds a poster background.
INVITE_EVENTS_JSON='[{"id":"the-lemons","title":"The Lemons","subtitle":"XXII — live show","date":"Sep 4, 2026","venue":"Ulaanbaatar","accent":"#e11d2e","imageUrl":"/posters/the-lemons.jpg"},{"id":"mc-collection","title":"MC Collection","subtitle":"Түүндээ — Live Show","date":"Sep 5, 2026","venue":"Төв Цэнгэлдэх Хүрээлэн","accent":"#c99733","imageUrl":"/posters/mc-collection.webp"}]'
